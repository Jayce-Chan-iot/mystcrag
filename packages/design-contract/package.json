{
  "name": "@mystcrag/design-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./fixtures": {
      "import": {
        "types": "./dist/esm/fixtures/index.d.ts",
        "default": "./dist/esm/fixtures/index.js"
      },
      "require": {
        "types": "./dist/cjs/fixtures/index.d.ts",
        "default": "./dist/cjs/fixtures/index.js"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/esm/schemas/internal-commercial.schema.d.ts",
        "default": "./dist/esm/schemas/internal-commercial.schema.js"
      },
      "require": {
        "types": "./dist/cjs/schemas/internal-commercial.schema.d.ts",
        "default": "./dist/cjs/schemas/internal-commercial.schema.js"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build-interop.mjs",
    "lint": "tsc --noEmit",
    "prepare": "node scripts/build-interop.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
