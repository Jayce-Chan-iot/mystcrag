generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  CNY
  TWD
}

enum DesignMode {
  AI_GENERATED
  DIY_CREATED
  AI_ASSISTED
  TEMPLATE_REMIX
  TAROT_GUIDED
}

enum TarotSpreadType {
  SINGLE
  PAST_PRESENT_FUTURE
}

enum TarotSessionStatus {
  DRAWING
  DRAWN
  RECOMMENDED
  SAVED
  ABANDONED
}

enum DesignStatus {
  DRAFT
  GENERATED
  SAVED
  ARCHIVED
}

enum ComplianceStatus {
  PENDING
  PASSED
  FLAGGED
  REJECTED
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum CreatorDisplayMode {
  ANONYMOUS
  DISPLAY_NAME
}

enum PublicationStatus {
  PUBLISHED
  UNPUBLISHED
}

enum OrderStatus {
  PENDING
  AWAITING_RESTOCK
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ProductType {
  MATERIAL
  ACCESSORY
}

enum DesignChangeType {
  CREATED
  UPDATED
  RESTORED
  AI_OPTIMIZED
}

enum KnowledgeStatus {
  NEW
  EXTRACTED
  VALIDATED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  CONFLICTED
  SUPERSEDED
}

enum KnowledgeVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// ---------------------------------------------------------------------------
// Bead asset import (TASK-ASSET-DB-001). Lifecycle enums mirror the accepted
// design contract (bead-asset-import-api.schema.ts) exactly; CANCELLED is a
// first-class terminal session state.
// ---------------------------------------------------------------------------

enum AssetImportSessionState {
  CREATED
  UPLOADING
  ARCHIVING
  PROCESSING
  NEEDS_REVIEW
  READY_TO_PUBLISH
  PUBLISHING
  PUBLISHED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum AssetImportCheckpoint {
  ARCHIVED
  GROUPED
  LABELED
  PROCESSED
  REVIEWED
  PUBLISHED
}

enum AssetSourceFileKind {
  ARW
  JPEG
  PNG
  WEBP
}

enum AssetSourceFileState {
  PENDING
  UPLOADING
  ARCHIVED
  FAILED
  SKIPPED_DUPLICATE
}

enum BeadImageGroupState {
  SUGGESTED
  CONFIRMED
  NAMED
  PROCESSED
  QC_FAILED
  READY
  PUBLISHED
}

enum ProcessedAssetPurpose {
  MAIN
  TEXTURE
  MODEL
  PREVIEW
}

enum ProcessedAssetState {
  DRAFT
  QC_PENDING
  QC_FAILED
  APPROVED
  RETIRED
}

enum AssetProcessingJobType {
  ARCHIVE_FILE
  GROUP_SESSION
  PROCESS_GROUP
}

enum AssetProcessingJobState {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AssetUsagePermission {
  UNKNOWN
  OWNED
  GRANTED
  PROHIBITED
}

enum ProductAssetBindingStatus {
  DRAFT
  APPROVED
  RETIRED
}

model User {
  id                 String              @id @default(cuid())
  email              String?             @unique
  displayName        String?             @map("display_name")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  designs            Design[]
  revisions          DesignRevision[]
  publications       DesignPublication[]
  orders             Order[]
  tarotSessions      TarotSession[]
  externalIdentities ExternalIdentity[]

  @@map("users")
}

model ExternalIdentity {
  id            String   @id @default(cuid())
  issuer        String
  subject       String
  userId        String   @map("user_id")
  email         String?
  emailVerified Boolean? @map("email_verified")
  displayName   String?  @map("display_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("external_identities")
}

model Crystal {
  id                 String            @id @default(cuid())
  nameCn             String            @map("name_cn")
  nameEn             String            @map("name_en")
  mineralName        String            @map("mineral_name")
  gemologicalInfo    Json              @map("gemological_info")
  colorTags          String[]          @map("color_tags")
  visualTags         String[]          @map("visual_tags")
  styleTags          String[]          @map("style_tags")
  emotionTags        String[]          @map("emotion_tags")
  cultureTags        String[]          @map("culture_tags")
  priceLevel         Int               @map("price_level")
  marketAvailability String?           @map("market_availability")
  costRange          Json?             @map("cost_range")
  imageReference     String?           @map("image_reference")
  complianceNote     String            @map("compliance_note")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  materialProducts   MaterialProduct[]
  assetImportGroups  BeadImageGroup[]
  promotedDrafts     CrystalDraft[]

  @@map("crystals")
}

model DesignTemplate {
  id                 String   @id @default(cuid())
  name               String
  theme              String
  emotion            String[]
  targetUser         String?  @map("target_user")
  style              String[]
  colorPalette       String[] @map("color_palette")
  crystalCombination Json     @map("crystal_combination")
  beadSequence       Json     @map("bead_sequence")
  metalAccessories   Json?    @map("metal_accessories")
  priceRange         Json     @map("price_range")
  popularityScore    Float    @default(0) @map("popularity_score")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("design_templates")
}

model Design {
  id                   String                      @id
  ownerId              String                      @map("owner_id")
  name                 String
  mode                 DesignMode
  status               DesignStatus                @default(DRAFT)
  schemaVersion        String                      @map("schema_version")
  currentRevision      Int                         @default(1) @map("current_revision")
  locale               String
  currency             Currency
  currentSnapshot      Json                        @map("current_snapshot")
  complianceStatus     ComplianceStatus            @map("compliance_status")
  visibility           Visibility                  @default(PRIVATE)
  publishConsent       Boolean                     @default(false) @map("publish_consent")
  allowRemix           Boolean                     @default(false) @map("allow_remix")
  creatorDisplayMode   CreatorDisplayMode          @default(ANONYMOUS) @map("creator_display_mode")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  deletedAt            DateTime?                   @map("deleted_at")
  owner                User                        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  revisions            DesignRevision[]
  publications         DesignPublication[]
  decisionTraces       DesignDecisionTrace[]
  tarotRecommendations TarotDesignRecommendation[]
  usageEvents          KnowledgeUsageEvent[]

  @@index([ownerId, updatedAt])
  @@index([status, deletedAt])
  @@map("designs")
}

model DesignDecisionTrace {
  id             String   @id @default(cuid())
  designId       String   @map("design_id")
  revisionNumber Int      @map("revision_number")
  trace          Json
  createdAt      DateTime @default(now()) @map("created_at")
  design         Design   @relation(fields: [designId], references: [id], onDelete: Restrict)

  @@unique([designId, revisionNumber])
  @@map("design_decision_traces")
}

model KnowledgeUsageEvent {
  id                    String   @id @default(cuid())
  eventType             String   @map("event_type")
  actorId               String?  @map("actor_id")
  designId              String?  @map("design_id")
  revisionNumber        Int?     @map("revision_number")
  knowledgeVersion      String?  @map("knowledge_version")
  productCatalogVersion String?  @map("product_catalog_version")
  payload               Json
  createdAt             DateTime @default(now()) @map("created_at")
  design                Design?  @relation(fields: [designId], references: [id], onDelete: Restrict)

  @@index([eventType, createdAt])
  @@index([designId, createdAt])
  @@map("knowledge_usage_events")
}

model DesignRevision {
  id             String              @id @default(cuid())
  designId       String              @map("design_id")
  revisionNumber Int                 @map("revision_number")
  schemaVersion  String              @map("schema_version")
  snapshot       Json
  changeType     DesignChangeType    @map("change_type")
  changeReason   String?             @map("change_reason")
  createdBy      String              @map("created_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  design         Design              @relation(fields: [designId], references: [id], onDelete: Restrict)
  actor          User                @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  publications   DesignPublication[]
  orders         Order[]

  @@unique([designId, revisionNumber])
  @@index([createdBy, createdAt])
  @@map("design_revisions")
}

model DesignPublication {
  id                 String             @id @default(cuid())
  designId           String             @map("design_id")
  designRevisionId   String             @map("design_revision_id")
  publishedById      String             @map("published_by_id")
  visibility         Visibility
  publishConsent     Boolean            @map("publish_consent")
  allowRemix         Boolean            @default(false) @map("allow_remix")
  creatorDisplayMode CreatorDisplayMode @map("creator_display_mode")
  publicationStatus  PublicationStatus  @default(PUBLISHED) @map("publication_status")
  publishedAt        DateTime           @default(now()) @map("published_at")
  unpublishedAt      DateTime?          @map("unpublished_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  design             Design             @relation(fields: [designId], references: [id], onDelete: Restrict)
  designRevision     DesignRevision     @relation(fields: [designRevisionId], references: [id], onDelete: Restrict)
  publishedBy        User               @relation(fields: [publishedById], references: [id], onDelete: Restrict)

  @@index([publicationStatus, publishedAt])
  @@index([designId, publicationStatus])
  @@map("design_publications")
}

model Order {
  id               String               @id @default(cuid())
  idempotencyKey   String?              @unique @map("idempotency_key")
  userId           String               @map("user_id")
  status           OrderStatus          @default(PENDING)
  currency         Currency
  totalAmountMinor BigInt               @map("total_amount_minor")
  designRevisionId String               @map("design_revision_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  designRevision   DesignRevision       @relation(fields: [designRevisionId], references: [id], onDelete: Restrict)
  designSnapshot   OrderDesignSnapshot?

  @@index([userId, createdAt])
  @@index([designRevisionId])
  @@map("orders")
}

model OrderDesignSnapshot {
  id                  String   @id @default(cuid())
  orderId             String   @unique @map("order_id")
  schemaVersion       String   @map("schema_version")
  designSnapshot      Json     @map("design_snapshot")
  pricingSnapshot     Json     @map("pricing_snapshot")
  productionSnapshot  Json     @map("production_snapshot")
  fulfillmentSnapshot Json     @map("fulfillment_snapshot")
  currency            Currency
  pricingRuleVersion  String   @map("pricing_rule_version")
  createdAt           DateTime @default(now()) @map("created_at")
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("order_design_snapshots")
}

model MaterialProduct {
  id                  String   @id
  crystalId           String   @map("crystal_id")
  sku                 String   @unique
  name                String
  shape               String
  diameterMm          Float    @map("diameter_mm")
  lengthAlongStringMm Float?   @map("length_along_string_mm")
  holeDiameterMm      Float?   @map("hole_diameter_mm")
  grade               String?
  visualProfile       Json?    @map("visual_profile")
  materialKey         String   @map("material_key")
  modelAssetKey       String?  @map("model_asset_key")
  textureAssetKey     String?  @map("texture_asset_key")
  currency            Currency
  unitPriceMinor      BigInt   @map("unit_price_minor")
  unitCostMinor       BigInt   @map("unit_cost_minor")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  crystal             Crystal  @relation(fields: [crystalId], references: [id], onDelete: Restrict)
  assetBindings       ProductAssetBinding[]

  @@index([crystalId, active])
  @@index([currency, active])
  @@map("material_products")
}

model AccessoryProduct {
  id                  String   @id
  sku                 String   @unique
  accessoryType       String   @map("accessory_type")
  material            String
  finish              String
  dimensions          Json
  lengthAlongStringMm Float?   @map("length_along_string_mm")
  visualProfile       Json?    @map("visual_profile")
  modelAssetKey       String?  @map("model_asset_key")
  textureAssetKey     String?  @map("texture_asset_key")
  currency            Currency
  unitPriceMinor      BigInt   @map("unit_price_minor")
  unitCostMinor       BigInt   @map("unit_cost_minor")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([currency, active])
  @@map("accessory_products")
}

model InventorySnapshot {
  id                String      @id @default(cuid())
  productType       ProductType @map("product_type")
  productId         String      @map("product_id")
  availableQuantity Int         @map("available_quantity")
  reservedQuantity  Int         @default(0) @map("reserved_quantity")
  capturedAt        DateTime    @default(now()) @map("captured_at")
  sourceVersion     String      @map("source_version")

  @@unique([productType, productId, sourceVersion])
  @@index([productType, productId, capturedAt])
  @@map("inventory_snapshots")
}

model PricingRule {
  id          String   @id @default(cuid())
  version     String
  currency    Currency
  active      Boolean  @default(true)
  rulePayload Json     @map("rule_payload")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([version, currency])
  @@index([currency, active])
  @@map("pricing_rules")
}

model KnowledgeSource {
  id                      String              @id
  name                    String
  sourceType              String              @map("source_type")
  baseUrl                 String?             @map("base_url")
  enabled                 Boolean             @default(false)
  authorityScore          Float               @map("authority_score")
  allowedKnowledgeDomains String[]            @map("allowed_knowledge_domains")
  crawlFrequency          String?             @map("crawl_frequency")
  language                String
  rateLimit               Json?               @map("rate_limit")
  legalNote               String?             @map("legal_note")
  sourceCategory          String              @default("MANUAL") @map("source_category")
  reliabilityLevel        String              @default("MEDIUM") @map("reliability_level")
  countryOrRegion         String?             @map("country_or_region")
  contentType             String              @default("OTHER") @map("content_type")
  crawlStrategy           Json?               @map("crawl_strategy")
  reviewStatus            String              @default("NEEDS_REVIEW") @map("review_status")
  lastSuccessfulFetch     DateTime?           @map("last_successful_fetch")
  lastFailure             Json?               @map("last_failure")
  consecutiveFailures     Int                 @default(0) @map("consecutive_failures")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  documents               KnowledgeDocument[]
  rules                   KnowledgeRule[]

  @@index([enabled])
  @@index([reviewStatus, enabled])
  @@map("knowledge_sources")
}

model KnowledgeDocument {
  id            String          @id
  sourceId      String          @map("source_id")
  url           String
  urlNormalized String          @map("url_normalized")
  contentHash   String          @unique @map("content_hash")
  title         String
  contentText   String          @map("content_text")
  fetchedAt     DateTime        @map("fetched_at")
  parser        String
  language      String
  status        String          @default("FETCHED")
  createdAt     DateTime        @default(now()) @map("created_at")
  source        KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sourceId])
  @@index([sourceId, fetchedAt])
  @@index([urlNormalized])
  @@map("knowledge_documents")
}

model KnowledgeRule {
  id                 String            @id
  sourceId           String            @map("source_id")
  knowledgeType      String            @map("knowledge_type")
  knowledgeDomain    String            @map("knowledge_domain")
  subject            String
  relation           String
  payload            Json
  conditions         Json              @default("{}")
  confidence         Float
  claimType          String?           @map("claim_type")
  status             KnowledgeStatus   @default(NEW)
  fingerprint        String            @unique
  sourceRefs         Json              @map("source_refs")
  version            Int               @default(1)
  knowledgeVersionId String?           @map("knowledge_version_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  source             KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  knowledgeVersion   KnowledgeVersion? @relation(fields: [knowledgeVersionId], references: [id], onDelete: Restrict)

  @@index([status, knowledgeDomain])
  @@index([knowledgeVersionId])
  @@index([subject, relation])
  @@map("knowledge_rules")
}

/// One row per `knowledge:collect` execution (Knowledge Console V1): written
/// RUNNING when the crawl starts, updated to COMPLETED/FAILED when it ends, so
/// the console's Collection Runs page tracks real runs instead of committed
/// JSON reports.
model KnowledgeCollectionRun {
  id                     String    @id @default(cuid())
  status                 String    @default("RUNNING")
  startedAt              DateTime  @map("started_at")
  finishedAt             DateTime? @map("finished_at")
  sourcesCrawled         Int       @default(0) @map("sources_crawled")
  documentsAdded         Int       @default(0) @map("documents_added")
  documentDuplicates     Int       @default(0) @map("document_duplicates")
  candidatesInserted     Int       @default(0) @map("candidates_inserted")
  corroboratedCandidates Int       @default(0) @map("corroborated_candidates")
  candidateDuplicates    Int       @default(0) @map("candidate_duplicates")
  needsReview            Int       @default(0) @map("needs_review")
  conflicts              Int       @default(0) @map("conflicts")
  errors                 Json      @default("[]") @map("errors")
  sourceResults          Json      @default("[]") @map("source_results")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([startedAt])
  @@map("knowledge_collection_runs")
}

model KnowledgeVersion {
  id          String                 @id
  version     String                 @unique
  status      KnowledgeVersionStatus @default(DRAFT)
  ruleCount   Int                    @default(0) @map("rule_count")
  publishedAt DateTime?              @map("published_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  rules       KnowledgeRule[]

  @@index([status])
  @@map("knowledge_versions")
}

model TarotSession {
  id                     String                      @id @default(cuid())
  ownerId                String                      @map("owner_id")
  spreadType             TarotSpreadType             @map("spread_type")
  theme                  String
  status                 TarotSessionStatus          @default(DRAWING)
  stateRevision          Int                         @default(1) @map("state_revision")
  deckVersion            String                      @map("deck_version")
  ruleVersion            String                      @map("rule_version")
  privateDeckState       Json                        @map("private_deck_state")
  drawSnapshot           Json                        @map("draw_snapshot")
  recommendationSnapshot Json?                       @map("recommendation_snapshot")
  questionCiphertext     String?                     @map("question_ciphertext")
  questionSavedAt        DateTime?                   @map("question_saved_at")
  selectedDesignId       String?                     @map("selected_design_id")
  parentSessionId        String?                     @map("parent_session_id")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  owner                  User                        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  parentSession          TarotSession?               @relation("TarotRedraw", fields: [parentSessionId], references: [id], onDelete: Restrict)
  redraws                TarotSession[]              @relation("TarotRedraw")
  recommendations        TarotDesignRecommendation[]

  @@index([ownerId, updatedAt])
  @@map("tarot_sessions")
}

model TarotDesignRecommendation {
  id        String       @id @default(cuid())
  sessionId String       @map("session_id")
  designId  String       @map("design_id")
  rank      Int
  createdAt DateTime     @default(now()) @map("created_at")
  session   TarotSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  design    Design       @relation(fields: [designId], references: [id], onDelete: Restrict)

  @@unique([sessionId, rank])
  @@unique([sessionId, designId])
  @@map("tarot_design_recommendations")
}

/// One admin import run. `idempotencyKey` deduplicates session creation; the
/// manifest key/fingerprint pair deduplicates manifest registration. Only
/// provider names and storage/archive keys are stored, never absolute paths.
model AssetImportSession {
  id                     String                 @id @default(cuid())
  idempotencyKey         String                 @unique @map("idempotency_key")
  state                  AssetImportSessionState @default(CREATED)
  lastVerifiedCheckpoint AssetImportCheckpoint? @map("last_verified_checkpoint")
  declaredFileCount      Int                    @default(0) @map("declared_file_count")
  archivedFileCount      Int                    @default(0) @map("archived_file_count")
  failedFileCount        Int                    @default(0) @map("failed_file_count")
  declaredBytes          BigInt                 @default(0) @map("declared_bytes")
  uploadedBytes          BigInt                 @default(0) @map("uploaded_bytes")
  manifestIdempotencyKey String?                @map("manifest_idempotency_key")
  manifestFingerprint    String?                @map("manifest_fingerprint")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  sourceFiles            AssetSourceFile[]
  groups                 BeadImageGroup[]
  jobs                   AssetProcessingJob[]

  @@index([state, updatedAt])
  @@map("asset_import_sessions")
}

/// One client-declared file. `(sessionId, clientFileId)` is unique; the
/// partial unique index on `(session_id, sha256) WHERE state = 'ARCHIVED'`
/// (migration SQL) enforces per-session exact SHA-256 deduplication.
model AssetSourceFile {
  id              String              @id @default(cuid())
  sessionId       String              @map("session_id")
  clientFileId    String              @map("client_file_id")
  relativePath    String              @map("relative_path")
  byteSize        BigInt              @map("byte_size")
  kind            AssetSourceFileKind
  state           AssetSourceFileState @default(PENDING)
  sha256          String?
  archiveKey      String?             @map("archive_key")
  storageProvider String?             @map("storage_provider")
  duplicateOfId   String?             @map("duplicate_of_id")
  duplicateOf     AssetSourceFile?    @relation("AssetSourceFileDuplicate", fields: [duplicateOfId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  duplicates      AssetSourceFile[]   @relation("AssetSourceFileDuplicate")
  groupId         String?             @map("group_id")
  group           BeadImageGroup?     @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  archivedAt      DateTime?           @map("archived_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  session         AssetImportSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  processedAssets ProcessedAsset[]

  @@unique([sessionId, clientFileId])
  @@index([sessionId, state])
  @@index([groupId])
  @@map("asset_source_files")
}

/// A reviewable cluster of bead photos. `revision` is the compare-and-set
/// guard for every operator edit (draft save, publish).
model BeadImageGroup {
  id                String             @id @default(cuid())
  sessionId         String             @map("session_id")
  state             BeadImageGroupState @default(SUGGESTED)
  revision          Int                @default(1)
  crystalName       String?            @map("crystal_name")
  primaryFileId     String?            @map("primary_file_id")
  similarityEvidence Json?             @map("similarity_evidence")
  crystalId         String?            @map("crystal_id")
  crystal           Crystal?           @relation(fields: [crystalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crystalDraftId    String?            @map("crystal_draft_id")
  crystalDraft      CrystalDraft?      @relation(fields: [crystalDraftId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  session           AssetImportSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  files             AssetSourceFile[]
  assets            ProcessedAsset[]
  jobs              AssetProcessingJob[]
  productDraft      MaterialProductDraft?
  publications      BeadGroupPublication[]

  @@index([sessionId, state])
  @@index([state, updatedAt])
  @@map("bead_image_groups")
}

/// Pre-curation crystal candidate. Promoted into a real `Crystal` only inside
/// the publish transaction after explicit operator confirmation.
model CrystalDraft {
  id                String           @id @default(cuid())
  nameCn            String           @map("name_cn")
  nameEn            String?          @map("name_en")
  mineralName       String           @map("mineral_name")
  gemologicalInfo   Json             @default("{}") @map("gemological_info")
  complianceNote    String           @map("compliance_note")
  promotedCrystalId String?          @map("promoted_crystal_id")
  promotedCrystal   Crystal?         @relation(fields: [promotedCrystalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  promotedAt        DateTime?        @map("promoted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  groups            BeadImageGroup[]

  @@map("crystal_drafts")
}

/// Operator-editable draft fields for one group; one row per group. Drafts are
/// never visible through approved-only public asset queries.
model MaterialProductDraft {
  id                   String               @id @default(cuid())
  groupId              String               @unique @map("group_id")
  crystalName          String?              @map("crystal_name")
  crystalId            String?              @map("crystal_id")
  crystalDraftId       String?              @map("crystal_draft_id")
  displayName          String?              @map("display_name")
  sku                  String?              @map("sku")
  materialKey          String?              @map("material_key")
  shape                String?
  diameterMm           Float?               @map("diameter_mm")
  lengthAlongStringMm  Float?               @map("length_along_string_mm")
  currency             Currency?
  unitPriceMinor       BigInt?              @map("unit_price_minor")
  costMinor            BigInt?              @map("cost_minor")
  availableQuantity    Int?                 @map("available_quantity")
  qualityStatement     String?              @map("quality_statement")
  qualitySource        String?              @map("quality_source")
  textureAssetKey      String?              @map("texture_asset_key")
  modelAssetKey        String?              @map("model_asset_key")
  rightsHolder         String?              @map("rights_holder")
  usagePermission      AssetUsagePermission? @map("usage_permission")
  isAuthenticPhotograph Boolean?            @map("is_authentic_photograph")
  allowAiTraining      Boolean?             @map("allow_ai_training")
  allowCommercialUse   Boolean?             @map("allow_commercial_use")
  allowPublicDisplay   Boolean?             @map("allow_public_display")
  allowAiRecommendation Boolean?            @map("allow_ai_recommendation")
  draftSavedAt         DateTime             @default(now()) @map("draft_saved_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  group                BeadImageGroup       @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("material_product_drafts")
}

/// One processed output version. `assetKey` is the content-addressed public key
/// `approved:<sha256>` and is globally unique among approved assets; the
/// partial unique index on `(group_id, purpose) WHERE is_current_version`
/// (migration SQL) keeps exactly one current version per purpose.
model ProcessedAsset {
  id                    String               @id @default(cuid())
  sourceFileId          String               @map("source_file_id")
  groupId               String               @map("group_id")
  purpose               ProcessedAssetPurpose
  processingVersion     Int                  @map("processing_version")
  state                 ProcessedAssetState  @default(QC_PENDING)
  storageProvider       String               @map("storage_provider")
  storageKey            String               @map("storage_key")
  assetKey              String?              @unique @map("asset_key")
  outputSha256          String               @map("output_sha256")
  outputBytes           BigInt               @map("output_bytes")
  outputContentType     String               @map("output_content_type")
  widthPx               Int?                 @map("width_px")
  heightPx              Int?                 @map("height_px")
  processorVersion      String               @map("processor_version")
  parameters            Json                 @default("{}")
  qcResult              Json                 @map("qc_result")
  qcPassedAt            DateTime?            @map("qc_passed_at")
  approvedAt            DateTime?            @map("approved_at")
  usagePermission       AssetUsagePermission @map("usage_permission")
  isAuthenticPhotograph Boolean              @default(false) @map("is_authentic_photograph")
  allowCommercialUse    Boolean              @default(false) @map("allow_commercial_use")
  allowPublicDisplay    Boolean              @default(false) @map("allow_public_display")
  isCurrentVersion      Boolean              @default(false) @map("is_current_version")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  sourceFile            AssetSourceFile      @relation(fields: [sourceFileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  group                 BeadImageGroup       @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bindings              ProductAssetBinding[]

  @@unique([groupId, purpose, processingVersion])
  @@index([groupId, state])
  @@index([assetKey])
  @@map("processed_assets")
}

/// Worker job with a PostgreSQL-native lease. claimNextJob uses
/// `FOR UPDATE SKIP LOCKED`; `leaseToken` makes every heartbeat/complete/fail
/// a compare-and-set so a stale worker can never overwrite a reassigned job.
model AssetProcessingJob {
  id              String                  @id @default(cuid())
  sessionId       String                  @map("session_id")
  groupId         String?                 @map("group_id")
  jobType         AssetProcessingJobType  @map("job_type")
  state           AssetProcessingJobState @default(QUEUED)
  payload         Json                    @default("{}")
  result          Json?
  retryCount      Int                     @default(0) @map("retry_count")
  maxRetries      Int                     @default(3) @map("max_retries")
  workerId        String?                 @map("worker_id")
  leaseToken      String?                 @map("lease_token")
  leaseUntil      DateTime?               @map("lease_until")
  claimedAt       DateTime?               @map("claimed_at")
  nextAttemptAt   DateTime?               @map("next_attempt_at")
  errorCode       String?                 @map("error_code")
  errorMessage    String?                 @map("error_message")
  completedAt     DateTime?               @map("completed_at")
  failedAt        DateTime?               @map("failed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  session         AssetImportSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  group           BeadImageGroup?         @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([state, nextAttemptAt, createdAt])
  @@index([state, leaseUntil])
  @@index([sessionId, state])
  @@map("asset_processing_jobs")
}

/// Approved asset attached to a formal product. The partial unique index on
/// `material_product_id WHERE binding_status = 'APPROVED'` (migration SQL)
/// guarantees at most one active binding per product.
model ProductAssetBinding {
  id                 String                   @id @default(cuid())
  materialProductId  String                   @map("material_product_id")
  processedAssetId   String                   @map("processed_asset_id")
  assetKey           String                   @map("asset_key")
  purpose            ProcessedAssetPurpose
  bindingStatus      ProductAssetBindingStatus @default(DRAFT) @map("binding_status")
  allowPublicDisplay Boolean                  @default(false) @map("allow_public_display")
  allowCommercialUse Boolean                  @default(false) @map("allow_commercial_use")
  approvedAt         DateTime?                @map("approved_at")
  retiredAt          DateTime?                @map("retired_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  product            MaterialProduct          @relation(fields: [materialProductId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset              ProcessedAsset           @relation(fields: [processedAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([materialProductId, bindingStatus])
  @@index([assetKey, bindingStatus])
  @@map("product_asset_bindings")
}

/// Durable publish outcome; both `idempotencyKey` and `groupId` are unique so
/// an identical retry replays the stored result and any divergent retry
/// conflicts. `payloadFingerprint` separates same-key/different-payload abuse.
model BeadGroupPublication {
  id                  String            @id @default(cuid())
  groupId             String            @unique @map("group_id")
  idempotencyKey      String            @unique @map("idempotency_key")
  payloadFingerprint  String            @map("payload_fingerprint")
  materialProductId   String            @map("material_product_id")
  crystalId           String            @map("crystal_id")
  inventorySnapshotId String            @map("inventory_snapshot_id")
  publishedAssetKeys  String[]          @map("published_asset_keys")
  publishedAt         DateTime          @default(now()) @map("published_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  group               BeadImageGroup    @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([publishedAt])
  @@map("bead_group_publications")
}
