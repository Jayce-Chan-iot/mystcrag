# Isolated Medusa 2.21.2 commerce base (TASK-COMMERCE-MEDUSA-BASE-001).
# Local development only. COMMERCE_DATABASE_URL must point at an isolated
# database; it must never reuse the Mystcrag DATABASE_URL / user database.
#
# COMMERCE_DATABASE_URL must NOT be declared in a local .env file. The Medusa
# CLI preloads .env before the isolation guard runs, so a value loaded from a
# file cannot be attributed to its source; medusa-config refuses any loadable
# .env that declares it. Export it in the process environment instead:
#   export COMMERCE_DATABASE_URL=postgres://mystcrag_commerce:...@127.0.0.1:55432/mystcrag_commerce_dev

# Synthetic local values; use a distinct secret manager value outside local dev.
JWT_SECRET=change-me-local-development-only
COOKIE_SECRET=change-me-local-development-only

# Loopback origins only. Do not add Mystcrag public domains in this phase.
STORE_CORS=http://localhost:9000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000