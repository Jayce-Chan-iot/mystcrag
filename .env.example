DATABASE_URL="postgresql://mystcrag:mystcrag_dev@localhost:5432/mystcrag?schema=public"
TEST_DATABASE_URL="postgresql://mystcrag:mystcrag_dev@localhost:5432/mystcrag_test?schema=public"

BACKEND_PORT=4000
MYSTCRAG_BACKEND_ORIGIN="http://127.0.0.1:4000"
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:4000"

# Identity/session configuration. These MYSTCRAG_* names are the only authority;
# AUTH-005 must pass them explicitly to Auth0 SDK options and must not rely on
# implicit AUTH0_* aliases. This checked-in template contains no real credentials.
#
# development/test: loopback HTTP and signed-test are permitted only with the
# explicit flag below. staging/production: use isolated Auth0 clients, exact HTTPS
# origin/callback/logout values from secret-managed deployment inputs, no wildcard
# or localhost, and MYSTCRAG_AUTH_PROVIDER="auth0". Never share a client between
# environments or invent staging/production domains in this file.
NODE_ENV=development
MYSTCRAG_APP_ORIGIN="http://localhost:3000"
MYSTCRAG_AUTH_PROVIDER="signed-test"
MYSTCRAG_ENABLE_SIGNED_TEST_AUTH=true
MYSTCRAG_AUTH_SIGNING_SECRET=""
MYSTCRAG_AUTH_ISSUER="mystcrag-local"
MYSTCRAG_AUTH_AUDIENCE="mystcrag-backend"
MYSTCRAG_AUTH_CLIENT_ID=""
MYSTCRAG_AUTH_CLIENT_SECRET=""
MYSTCRAG_AUTH_CALLBACK_URL="http://localhost:3000/auth/callback"
MYSTCRAG_AUTH_LOGOUT_URL="http://localhost:3000"
# Auth0 SDK requires 32 random bytes encoded as 64 hexadecimal characters.
# Generate per environment with `openssl rand -hex 32`; never commit the result.
MYSTCRAG_AUTH_SESSION_SECRET=""

# Temporary development/test compatibility until AUTH-005 removes all production
# dependence. Generate this short-lived token with docs/LOCAL_DEMO_GUIDE.md.
NEXT_PUBLIC_MYSTCRAG_ACCESS_TOKEN=""

# Server-owned Tarot rollout gate. Only the exact value "true" enables new sessions.
MYSTCRAG_TAROT_ENABLED="false"

# Optional Tarot-question storage. Empty keeps opt-in storage unavailable.
# When enabled, replace with an exact 32-byte base64 key; never commit that key.
MYSTCRAG_TAROT_QUESTION_ENCRYPTION_KEY=""

# Optional semantic embedding endpoint (OpenAI-compatible POST embeddings API,
# e.g. TEI/Ollama/SiliconFlow serving BGE-M3). Empty keeps the deterministic
# hash baseline. Used identically by knowledge-worker indexing, backend
# recommendation, and MCP search (docs/KNOWLEDGE_SYSTEM_SPEC.md ADR-9).
KNOWLEDGE_EMBEDDING_ENDPOINT=""
KNOWLEDGE_EMBEDDING_MODEL="BAAI/bge-m3"
KNOWLEDGE_EMBEDDING_DIMENSIONS="1024"
KNOWLEDGE_EMBEDDING_API_KEY=""

# Optional LLM extraction endpoint (OpenAI-compatible chat completions) for
# semantic knowledge extraction. Empty keeps extraction deterministic
# (pattern extractor only). LLM candidates are always NEEDS_REVIEW and must
# quote verbatim document evidence (docs/KNOWLEDGE_SYSTEM_SPEC.md section 17.2).
KNOWLEDGE_EXTRACTION_ENDPOINT=""
KNOWLEDGE_EXTRACTION_MODEL=""
KNOWLEDGE_EXTRACTION_API_KEY=""

# Admin key for the knowledge review API (X-Admin-Key header, >=16 chars).
# Empty keeps the admin API unregistered (fail closed) — the review CLI keeps
# working (docs/KNOWLEDGE_SYSTEM_SPEC.md section 17.3).
KNOWLEDGE_ADMIN_API_KEY=""

# Knowledge Console V1 (/admin/knowledge). The Next server proxies console
# reads/writes to the Backend Admin API and attaches this key server-side; it
# must never be referenced from client components. Falls back to
# KNOWLEDGE_ADMIN_API_KEY when unset (docs/KNOWLEDGE_SYSTEM_SPEC.md section 18).
MYSTCRAG_KNOWLEDGE_ADMIN_KEY=""
