{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@mystcrag/backend#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@mystcrag/frontend#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@mystcrag/backend#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BACKEND_PORT",
        "DATABASE_URL",
        "MYSTCRAG_AUTH_AUDIENCE",
        "MYSTCRAG_AUTH_ISSUER",
        "MYSTCRAG_AUTH_PROVIDER",
        "MYSTCRAG_AUTH_SIGNING_SECRET",
        "MYSTCRAG_ENABLE_SIGNED_TEST_AUTH",
        "MYSTCRAG_TAROT_ENABLED",
        "MYSTCRAG_TAROT_QUESTION_ENCRYPTION_KEY",
        "NODE_ENV"
      ]
    },
    "@mystcrag/frontend#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "MYSTCRAG_BACKEND_ORIGIN",
        "MYSTCRAG_TAROT_ENABLED",
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_PUBLIC_MYSTCRAG_ACCESS_TOKEN",
        "NEXT_PUBLIC_MYSTCRAG_MOCK_API",
        "NODE_ENV"
      ]
    },
    "@mystcrag/mcp-server#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "MCP_TRANSPORT",
        "MCP_HOST",
        "MCP_PORT",
        "NODE_ENV"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
